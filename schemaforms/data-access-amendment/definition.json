[
  {
    "type": "fieldset",
    "items": [
      {
        "type": "help",
        "helpvalue": "<h2 class='text-center'>t(data-access-amendment.custom.form-title)</h2>"
      },
      {
        "type": "help",
        "helpvalue": "<hr>"
      },
      {
        "key": "titleResearchProject",
        "readonly": true,
        "condition": "model.titleResearchProject"
      }
    ]
  },
  {
    "type": "fieldset",
    "items": [
      "infoDarModification",
      {
        "type": "section",
        "items": [
          "titleResearchProject",
          "namePrincipalApplicant",
          "position",
          "primaryInstitution",
          "institutionalEmailAddress",
          "telephoneNumber",
          "institutionalMailingAddress"
        ],
        "condition": "model.infoDarModification"
      },
      {
        "type": "help",
        "helpvalue": "<hr>"
      },
      {
        "type": "section",
        "items": [
          {
            "type": "help",
            "helpvalue": "<h4>t(data-access-amendment.custom.research-project-time-table)</h4>"
          },
          {
            "type": "section",
            "htmlClass": "row",
            "items": [
              {
                "type": "section",
                "htmlClass": "col-md-12",
                "items": [
                  "startResearchProjectTimeTable"
                ]
              },
              {
                "type": "section",
                "htmlClass": "col-md-12",
                "items": [
                  "endResearchProjectTimeTable"
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "help",
        "helpvalue": "<hr>"
      },
      {
        "key": "institution",
        "readonly": true,
        "title": "I remain affiliated with",
        "labelHtmlClass": "font-weight-bold mr-2 mb-0 mt-0",
        "fieldHtmlClass": "border-0 bg-transparent shadow-none p-0 font-weight-bold w-auto",
        "htmlClass": "d-flex align-items-center mb-0"
      },
      {
        "key": "remainsAffiliated",
        "type": "radios-inline",
        "notitle": true,
        "htmlClass": "mt-0",
        "titleMap": [
          {
            "value": true,
            "name": "t(data-access-request.custom.response.affirmative)"
          },
          {
            "value": false,
            "name": "t(data-access-request.custom.response.negative)"
          }
        ]
      },
      {
        "type": "section",
        "htmlClass": "border p-3 mb-3",
        "condition": "model.remainsAffiliated !== true",
        "items": [
          {
            "type": "help",
            "helpvalue": "<p class='help-block mb-2'>t(data-access-amendment.custom.new-institution-title)</p>"
          },
          "newInstitution",
          {
            "type": "section",
            "items": [
              {
                "key": "newRepresentative",
                "notitle": true,
                "items": [
                  "newRepresentative.name",
                  "newRepresentative.position",
                  "newRepresentative.email",
                  "newRepresentative.phone",
                  "newRepresentative.mailingAddress"
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "items": [
          {
            "key": "currentStateProjectDescription",
            "type": "textarea"
          },
          {
            "key": "requestedChangesApprovedProtocolDescription",
            "type": "textarea"
          },
          {
            "key": "reasonsRelatedRequestDescription",
            "type": "textarea"
          }
        ]
      },
      {
        "type": "section",
        "condition": "model.staff && model.staff.length > 0",
        "htmlClass": "row",
        "items": [
          {
            "type": "section",
            "htmlClass": "col-xs-6",
            "items": [
              {
                "key": "staff",
                "add": null,
                "remove": null,
                "notitle": true,
                "items": [
                  {
                    "key": "staff[].remove"
                  },
                  {
                    "key": "staff[].name",
                    "readonly": true
                  },
                  {
                    "key": "staff[].role",
                    "readonly": true
                  },
                  {
                    "key": "staff[].institution",
                    "readonly": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]